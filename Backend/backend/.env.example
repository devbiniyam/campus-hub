# Campus Hub — Backend Environment Configuration Example
SECRET_KEY=your-super-secret-django-production-key
DEBUG=False
ALLOWED_HOSTS=*,localhost,127.0.0.1,.onrender.com,.vercel.app
DATABASE_URL=postgresql://user:password@host:5432/campus_hub_db
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app,https://*.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app,https://*.onrender.com
